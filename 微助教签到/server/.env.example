# 微助教后端生产环境变量示例配置文件
# 复制本文件为 .env 即可生效：cp .env.example .env

# 服务运行端口
PORT=17521

# API 接口访问密钥（用于客户端与管理端鉴权，请设置强密码）
API_KEY=your-secure-custom-api-key-2026

# yyb-go 微信协议底层引擎通信地址
YYB_GO_URL=http://127.0.0.1:8999

# SQLite 数据库存储绝对路径（不填则默认为 server/data.db）
DB_PATH=/home/ubuntu/tjcu-helper/server/data.db
