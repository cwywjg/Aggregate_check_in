# systemd EnvironmentFile syntax: KEY=value, no "export".
YKT_BIND_HOST=0.0.0.0
YKT_PORT=5000
YKT_HTTP_THREADS=24
YKT_BATCH_CONCURRENCY=16
YKT_REQUEST_TIMEOUT=12
YKT_AI_TIMEOUT=55
YKT_SUBMIT_PREFERRED_DELAY=20
YKT_SUBMIT_HARD_LIMIT=60
YKT_AI_THINKING_CUTOFF=25
YKT_SUBMIT_RESERVE=6
YKT_DEADLINE_SAFETY=1.5
YKT_API_RATE_LIMIT=300
YKT_AI_RATE_LIMIT=60
YKT_MAX_ACCOUNTS_PER_SYNC=500
YKT_ALLOW_REMOTE_ACCOUNT_DELETE=0
YKT_MAX_REQUEST_BYTES=4194304
YKT_MAX_IMAGE_BYTES=5242880
YKT_DATA_DIR=/var/lib/ykt
YKT_WS_URL=wss://changjiang.yuketang.cn/wsapp/
YKT_API_BASE=https://changjiang.yuketang.cn
YKT_WS_POLL_INTERVAL=3
YKT_MAX_ACTIVE_SESSIONS=8
YKT_ENABLE_AI_SELF_TEST=0
YKT_MONITOR_INTERVAL=21600
YKT_AI_HEALTH_INTERVAL=10800
YKT_AI_HEALTH_TIMEOUT=30
YKT_AI_HEALTH_HISTORY_LIMIT=100
YKT_STRICT_COVER_HOSTS=0
YKT_COVER_IMAGE_HOSTS=
YKT_IMAGE_HOSTS=
PYTHONDONTWRITEBYTECODE=1
TZ=Asia/Shanghai

# App 管理员控制台口令
YKT_ADMIN_KEY=your_admin_secret_key_2026

# AI provider: gemini / openai / nvidia / siliconflow / compatible
# 统一配置优先级最高。只用一套供应商时，填写这四项最省事。
AI_PROVIDER=nvidia
AI_API_KEY=
AI_BASE_URL=
AI_MODELS=
AI_ROUTES=nvidia|google/gemma-4-31b-it;cloudflare|@cf/qwen/qwen3.8-27b;siliconflow|Qwen/Qwen3.5-27B
AI_JSON_MODE=auto
AI_TEMPERATURE=0.1
AI_TOP_P=0.95
AI_MAX_TOKENS=1024
AI_ENABLE_THINKING=0
AI_MAX_RETRIES=0
AI_TOTAL_TIMEOUT=54
AI_ROUTE_TIMEOUT=8
AI_ROUTE_CYCLES=2
AI_THINKING_FIRST=1
AI_THINKING_TIMEOUT=25
AI_THINKING_HEDGE_DELAY=0
AI_THINKING_MAX_TOKENS=4096

# 供应商专属配置。统一 AI_* 为空时才读取这些值。
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=google/gemma-4-31b-it
NVIDIA_JSON_MODE=off
NVIDIA_INLINE_IMAGE_MAX_BYTES=174080
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODELS=Qwen/Qwen3.5-27B
SILICONFLOW_JSON_MODE=auto
SILICONFLOW_ENABLE_THINKING=0
SILICONFLOW_IMAGE_DETAIL=low
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=
CLOUDFLARE_MODELS=@cf/qwen/qwen3.8-27b
CLOUDFLARE_JSON_MODE=auto
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODELS=

# Optional account-validity notification.
PUSH_PLUS_TOKEN=
PUSH_PLUS_URL=https://www.pushplus.plus/send
