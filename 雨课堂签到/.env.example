# 雨课堂后端服务生产环境变量示例配置
# 复制本文件为 .env 即可生效：cp .env.example .env

# 服务监听端口 (默认 5000)
PORT=5000

# 多模态 AI 大模型服务提供商 (支持 siliconflow / nvidia / deepseek / gemini / openai)
AI_PROVIDER=siliconflow

# 大模型 API 密钥 (请前往对应模型平台申请)
AI_API_KEY=sk-your-siliconflow-or-nvidia-api-key

# 大模型 API 端点 (留空则默认使用各平台官方端点)
AI_BASE_URL=https://api.siliconflow.cn/v1

# 指定模型名称 (例如 Qwen/Qwen2.5-VL-72B-Instruct)
AI_MODELS=Qwen/Qwen2.5-VL-72B-Instruct

# 思考推理模式开关 (1: 开启, 0: 关闭)
AI_ENABLE_THINKING=1

# 图片解析清晰度模式 (low: 极速模式, high: 高清模式)
SILICONFLOW_IMAGE_DETAIL=low

# 单次请求超时时间 (秒)
YKT_AI_TIMEOUT=45
